name: Deploy to Production

# HOW TO USE:
# 1. Remove the '.example' extension from this file.
# 2. Add SERVER_HOST, SERVER_USER, and SSH_PRIVATE_KEY to your GitHub Repository Secrets.

on:
  push:
    branches:
      - main

jobs:
  deploy:
    runs-on: ubuntu-latest
    
    steps:
      - name: Deploy via SSH
        uses: appleboy/ssh-action@v1.0.3
        with:
          host: ${{ secrets.SERVER_HOST }}
          username: ${{ secrets.SERVER_USER }}
          key: ${{ secrets.SSH_PRIVATE_KEY }}
          script: |
            cd /path/to/your/project
            git pull origin main
            chmod +x deploy.sh
            ./deploy.sh